---
import BaseLayout from '../layouts/BaseLayout.astro';
import OssProjects from '../components/OssProjects.astro';
import { getContent } from '../i18n';

const t = getContent('en');
---

<BaseLayout
  locale="en"
  activeNav="oss"
  path="open-source/"
  title={t.oss.metaTitle}
  description={t.oss.metaDescription}
>
  <OssProjects locale="en" />
</BaseLayout>
