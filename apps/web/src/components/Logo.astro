---
import { Image } from 'astro:assets';
import { localeHome, type Locale } from '../i18n';
import blackLogo from '../assets/brand/causality-wordmark-black.png';
import whiteLogo from '../assets/brand/causality-wordmark-white.png';

/**
 * Brand lockup — the official Causality logo, recoloured ink on light surfaces
 * and white on the forest band. Rendered as a home link; the image alt supplies
 * the accessible name. Explicit width/height (from the 858×215 source) → no CLS;
 * astro:assets emits an optimised, retina (1x/2x) asset.
 */
interface Props {
  locale: Locale;
  variant?: 'ink' | 'onForest';
  height?: number;
  class?: string;
}
const { locale, variant = 'ink', height = 30, class: className } = Astro.props;
const home = localeHome(locale);
const src = variant === 'onForest' ? whiteLogo : blackLogo;
const width = Math.round(height * (858 / 215));
---

<a href={home} class:list={['inline-flex items-center', className]}>
  <Image
    src={src}
    alt="Causality"
    width={width}
    height={height}
    densities={[1, 2]}
    loading="eager"
  />
</a>
