---
import type { ServiceItem } from '../i18n/types';
import MonoLabel from './MonoLabel.astro';
import SchematicIcon from './SchematicIcon.astro';

/**
 * Editorial capability row (design.md §03): mono ref, schematic icon, H3 title,
 * one-line summary, mono keyword chips, and a lime → glyph that nudges on hover.
 * The primary row carries a 3px lime left-rule.
 */
interface Props {
  item: ServiceItem;
  icon: 'chip' | 'research' | 'braces' | 'box';
}
const { item, icon } = Astro.props;
---

<div
  class="border-hairline relative grid grid-cols-1 gap-y-3 border-t py-6 md:grid-cols-[8rem_1fr] md:items-baseline md:gap-x-6 md:py-7"
  data-reveal
>
  {/* Primary accent — a lime bar in the left margin, so it never shifts content */}
  {
    item.primary && (
      <span class="bg-lime absolute top-0 -left-4 h-full w-[3px] md:-left-6" aria-hidden="true" />
    )
  }

  <MonoLabel class="md:pt-1">{item.ref}</MonoLabel>

  <div class="max-w-[54ch]">
    <h3 class="text-h4 text-ink flex items-center gap-2.5 font-semibold">
      <SchematicIcon name={icon} class="text-ink-700 shrink-0" />
      {item.title}
    </h3>
    <p class="text-ink-700 mt-2">{item.summary}</p>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        item.keys.map((k) => (
          <li class="mono-label border-hairline bg-surface rounded-sm border px-2 py-1">{k}</li>
        ))
      }
    </ul>
  </div>
</div>
