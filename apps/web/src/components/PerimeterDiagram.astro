---
/**
 * SIEVE on-premise architecture (design.md §05): a dashed lime CUSTOMER
 * PERIMETER encloses the data store and SIEVE's vector index; a query snaps to
 * its nearest lime neighbour in-place; an egress arrow is blocked at the boundary
 * (NO DATA EGRESS). The message is always visible (not gated on motion). The
 * <title>/<desc> + adjacent <figcaption> give screen-reader parity.
 */
interface Props {
  title: string;
  desc: string;
  summary: string;
  perimeterLabel: string;
  egressLabel: string;
  class?: string;
}
const { title, desc, summary, perimeterLabel, egressLabel, class: className } = Astro.props;
const mono = 'font-family:var(--font-mono);font-size:11px;letter-spacing:0.04em';
---

<figure class:list={['flex flex-col gap-4', className]}>
  <div class="border-hairline bg-surface-sunk relative w-full rounded-md border p-3" data-draw>
    <svg
      viewBox="0 0 460 340"
      role="img"
      aria-labelledby="sieve-diagram-title sieve-diagram-desc"
      class="h-auto w-full"
    >
      <title id="sieve-diagram-title">{title}</title>
      <desc id="sieve-diagram-desc">{desc}</desc>

      {/* Perimeter label */}
      <text x="20" y="30" fill="#4C6E00" style={mono}>{perimeterLabel}</text>

      {/* Dashed lime customer perimeter (fades in) */}
      <rect
        class="draw-fade"
        x="20"
        y="42"
        width="300"
        height="278"
        rx="10"
        fill="none"
        stroke="#95D600"
        stroke-width="2"
        stroke-dasharray="7 6"
        style="--fade-delay:200ms"></rect>

      {/* Data store (cylinder) */}
      <g fill="none" stroke="#2A3326" stroke-width="1.5">
        <ellipse cx="92" cy="238" rx="40" ry="11" fill="#FFFFFF"></ellipse>
        <path d="M52 238 V286 A40 11 0 0 0 132 286 V238"></path>
        <path d="M52 262 A40 11 0 0 0 132 262" stroke="#C9CEC1"></path>
      </g>
      <text x="92" y="308" fill="#5F6659" text-anchor="middle" style={mono}>DATA STORE</text>

      {/* Feed from store into the index */}
      <line x1="118" y1="228" x2="176" y2="170" stroke="#D6DACF" stroke-width="1"></line>

      {/* SIEVE label */}
      <text x="150" y="86" fill="#5F6659" style={mono}>SIEVE</text>
      <text x="150" y="118" fill="#5F6659" style={mono}>QUERY</text>

      {/* Ambient index nodes */}
      <g fill="#C9CEC1">
        <circle cx="258" cy="104" r="3"></circle>
        <circle cx="205" cy="186" r="3"></circle>
        <circle cx="278" cy="168" r="3"></circle>
        <circle cx="232" cy="104" r="3"></circle>
      </g>
      <g stroke="#E3E6DE" stroke-width="1">
        <line x1="232" y1="104" x2="258" y2="104"></line>
        <line x1="205" y1="186" x2="238" y2="150"></line>
        <line x1="278" y1="168" x2="238" y2="150"></line>
      </g>

      {/* Query node → nearest-neighbour vector (draws in), then lime node */}
      <circle cx="158" cy="126" r="3.4" fill="#C9CEC1"></circle>
      <line
        class="draw-path"
        pathLength="1"
        x1="158"
        y1="126"
        x2="238"
        y2="150"
        stroke="#95D600"
        stroke-width="2"
        stroke-linecap="round"
        style="--draw-delay:400ms"></line>
      <g class="draw-fade" style="--fade-delay:1000ms">
        <circle cx="238" cy="150" r="5" fill="#95D600"></circle>
        <circle cx="238" cy="150" r="9" fill="none" stroke="#95D600" stroke-width="1.2"></circle>
      </g>

      {/* Blocked egress — ALWAYS visible (the message must not depend on motion) */}
      <line x1="278" y1="196" x2="316" y2="196" stroke="#2A3326" stroke-width="1.5"></line>
      <g stroke="#A31414" stroke-width="2.5" stroke-linecap="round">
        <line x1="315" y1="188" x2="327" y2="204"></line>
        <line x1="327" y1="188" x2="315" y2="204"></line>
      </g>
      <text x="336" y="192" fill="#2A3326" style={mono}>{egressLabel}</text>
      <text x="336" y="207" fill="#5F6659" style="font-family:var(--font-mono);font-size:9.5px">
        blocked at perimeter
      </text>
    </svg>
  </div>
  <figcaption class="measure text-body-sm text-muted">{summary}</figcaption>
</figure>
