---
import { getContent, type Locale } from '../i18n';
import MonoLabel from './MonoLabel.astro';
import CornerTicks from './CornerTicks.astro';
import IngestSources from './IngestSources.astro';
import { CORPUS, PRESETS, toSvg, VBW, VBH, scoreDot } from '../scripts/sieveData';

/**
 * SIEVE — scroll-driven demo (business audience). A pinned "map of your
 * documents" (2D semantic space) that animates step-by-step as plain-language
 * captions scroll past (driven by scrolly.ts via .scrolly-step + .st-reveal).
 * Server-renders the fully resolved state → the no-JS / reduced-motion fallback.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const d = t.sieve.demo;

const P = PRESETS[0];
const q = toSvg(P.qx, P.qy);
const docPos = CORPUS.map((c) => toSvg(c.x, c.y));
const nnRank = new Map<number, number>();
P.neighbours.forEach((n, i) => nnRank.set(n.doc, i));
const phrase = d.presets[0];
const tokens = phrase.split(' ');
const rows = P.neighbours.map((n, i) => ({ rank: i + 1, label: d.docs[n.doc], score: n.score }));
const clusterLabels = [
  { text: d.clusters[0], p: toSvg(23, 10) },
  { text: d.clusters[1], p: toSvg(53, 28) },
  { text: d.clusters[2], p: toSvg(27, 56) },
  { text: d.clusters[3], p: toSvg(78, 18) },
];
---

<div
  data-demo="sieve"
  class="border-hairline bg-surface-sunk relative rounded-md border p-5 md:p-7"
>
  <CornerTicks />

  {/* Header */}
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <MonoLabel>{d.plateTitle}</MonoLabel>
    <span class="inline-flex items-center gap-2">
      <span class="status-dot" aria-hidden="true"></span>
      <span class="mono-label text-lime-text">{d.badge}</span>
    </span>
  </div>

  <div class="relative mt-6 gap-10 lg:grid lg:grid-cols-[1.15fr_1fr]">
    {/* Pinned visual */}
    <div class="top-24 self-start lg:sticky">
      <figure>
        {/* ingestion (step 1) — everything flows in, even a forwarded email */}
        <div class="st-reveal mb-4" data-from="1">
          <IngestSources locale={locale} />
        </div>

        <div class="border-hairline bg-surface relative overflow-hidden rounded-md border">
          <svg
            viewBox={`0 0 ${VBW} ${VBH}`}
            role="img"
            aria-labelledby="sieve-fig-title sieve-fig-desc"
            class="h-auto w-full"
          >
            <title id="sieve-fig-title">{d.figureTitle}</title>
            <desc id="sieve-fig-desc">{d.figureDesc}</desc>

            <rect
              x="16"
              y="24"
              width={VBW - 32}
              height={VBH - 40}
              rx="4"
              fill="none"
              stroke="#ECEEE6"></rect>
            <text x="20" y="18" fill="#5F6659" style="font-family:var(--font-mono);font-size:10px"
              >{d.laneSpace}</text
            >

            {/* topic-cluster zone labels (always visible — the "map") */}
            <g
              fill="#8A9182"
              style="font-family:var(--font-mono);font-size:9px;letter-spacing:0.04em"
            >
              {
                clusterLabels.map((c) => (
                  <text x={c.p[0]} y={c.p[1]} text-anchor="middle">
                    {c.text}
                  </text>
                ))
              }
            </g>

            {/* leaders: query → nearest matches (step 4) */}
            <g
              class="st-reveal"
              data-from="4"
              stroke="#95D600"
              stroke-width="1.5"
              stroke-linecap="round"
            >
              {
                P.neighbours.map((n) => (
                  <line x1={q[0]} y1={q[1]} x2={docPos[n.doc][0]} y2={docPos[n.doc][1]} />
                ))
              }
            </g>

            {/* all documents — the "map", always visible as neutral dots */}
            <g fill="#C9CEC1">
              {CORPUS.map((_c, i) => <circle cx={docPos[i][0]} cy={docPos[i][1]} r="3.5" />)}
            </g>
            {/* lime highlight over the nearest matches (step 4) */}
            <g class="st-reveal" data-from="4" fill="#95D600">
              {
                P.neighbours.map((n) => (
                  <circle cx={docPos[n.doc][0]} cy={docPos[n.doc][1]} r="4.5" />
                ))
              }
            </g>

            {/* neighbour halos + score chips (step 4) */}
            <g class="st-reveal" data-from="4">
              {
                P.neighbours.map((n) => (
                  <circle
                    cx={docPos[n.doc][0]}
                    cy={docPos[n.doc][1]}
                    r="8.5"
                    fill="none"
                    stroke="#95D600"
                    stroke-width="1.2"
                  />
                ))
              }
            </g>
            <g
              class="st-reveal"
              data-from="4"
              fill="#0B0F0A"
              style="font-family:var(--font-mono);font-size:11px"
            >
              {
                P.neighbours.map((n) => (
                  <text x={docPos[n.doc][0] + 11} y={docPos[n.doc][1] + 4}>
                    {scoreDot(n.score)}
                  </text>
                ))
              }
            </g>

            {/* query point (step 3) — cx/cy so the reveal slide doesn't fight a transform */}
            <g class="st-reveal" data-from="3">
              <circle cx={q[0]} cy={q[1]} r="9" fill="none" stroke="#95D600" stroke-width="1.2"
              ></circle>
              <circle cx={q[0]} cy={q[1]} r="5" fill="#95D600"></circle>
            </g>
          </svg>
        </div>

        {/* the question (step 2) */}
        <div class="st-reveal mt-4 flex flex-wrap items-center gap-2" data-from="2">
          <MonoLabel>{d.laneQuery}</MonoLabel>
          <span aria-hidden="true" class="text-border-strong">›</span>
          <ul class="flex flex-wrap gap-1.5">
            {
              tokens.map((tok) => (
                <li class="border-hairline bg-surface text-ink rounded-sm border px-2 py-1 font-mono text-[0.75rem]">
                  {tok}
                </li>
              ))
            }
          </ul>
        </div>

        {/* ranked results (step 5) */}
        <div class="st-reveal mt-4" data-from="5">
          <MonoLabel as="p" class="mb-2">{d.resultsTitle}</MonoLabel>
          <ol class="border-hairline overflow-hidden rounded-md border">
            {
              rows.map((r, i) => (
                <li class="border-hairline bg-surface relative grid grid-cols-[2rem_1fr_auto] items-center gap-3 border-t px-4 py-2.5 first:border-t-0">
                  {i === 0 && (
                    <span class="bg-lime absolute top-0 left-0 h-full w-[3px]" aria-hidden="true" />
                  )}
                  <span class="mono-label">{String(r.rank).padStart(2, '0')}</span>
                  <span class="text-body-sm text-ink flex items-center gap-2">
                    {r.label}
                    {i === 0 && <span class="mono-label text-lime-text">{d.nearest}</span>}
                  </span>
                  <span class="text-body-sm tnum text-ink font-mono">{scoreDot(r.score)}</span>
                </li>
              ))
            }
          </ol>
        </div>
      </figure>
    </div>

    {/* Scrolling captions */}
    <ol class="mt-8 flex flex-col lg:mt-0" aria-label={d.plateTitle}>
      {
        d.steps.map((step, i) => (
          <li class="scrolly-step flex min-h-[46vh] flex-col justify-center border-l-2 border-transparent pl-5 lg:min-h-[62vh]">
            <MonoLabel>{String(i + 1).padStart(2, '0')} / 05</MonoLabel>
            <p class="text-h4 text-ink mt-3 font-medium">{step}</p>
          </li>
        ))
      }
    </ol>
  </div>
</div>
