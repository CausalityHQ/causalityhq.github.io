---
import { getContent, type Locale } from '../i18n';
import MonoLabel from './MonoLabel.astro';
import CornerTicks from './CornerTicks.astro';
import { CORPUS, PRESETS, toSvg, VBW, VBH, scoreDot, scoreProse } from '../scripts/sieveData';

/**
 * SIEVE semantic-search demo (INTERACTIVE.md §B). Server-renders the RESOLVED P1
 * state (the meaningful no-JS / reduced-motion fallback). sieveDemo.ts mounts on
 * scroll-near and drives preset selection + the search choreography.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const d = t.sieve.demo;

const P1 = PRESETS[0];
const q1 = toSvg(P1.qx, P1.qy);
const docPos = CORPUS.map((c) => toSvg(c.x, c.y));
const nnRank = new Map<number, number>();
P1.neighbours.forEach((n, i) => nnRank.set(n.doc, i));
const p1phrase = d.presets[0];
const tokens = p1phrase.split(' ');

const leaders = P1.neighbours.map((n) => ({ x2: docPos[n.doc][0], y2: docPos[n.doc][1] }));
const rows = P1.neighbours.map((n, i) => ({
  rank: i + 1,
  label: d.docs[n.doc],
  score: n.score,
}));
const fig = d.figcaptionTpl
  .replace('{q}', p1phrase)
  .replace('{n1}', d.docs[P1.neighbours[0].doc])
  .replace('{s1}', scoreProse(P1.neighbours[0].score, locale))
  .replace('{n2}', d.docs[P1.neighbours[1].doc])
  .replace('{s2}', scoreProse(P1.neighbours[1].score, locale))
  .replace('{n3}', d.docs[P1.neighbours[2].doc])
  .replace('{s3}', scoreProse(P1.neighbours[2].score, locale));
---

<div
  data-demo="sieve"
  class="border-hairline bg-surface-sunk relative rounded-md border p-5 md:p-7"
>
  <CornerTicks />

  {/* Header */}
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <MonoLabel>{d.plateTitle}</MonoLabel>
    <div class="flex flex-wrap items-center gap-x-4 gap-y-1">
      <span class="inline-flex items-center gap-2">
        <span class="status-dot" aria-hidden="true"></span>
        <span class="mono-label text-lime-text">{d.badge}</span>
      </span>
      <span class="mono-label">{d.meter}</span>
    </div>
  </div>

  {/* Controls */}
  <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-end md:justify-between">
    <div>
      <MonoLabel as="p" id="sieve-presets-label" class="mb-2">{d.presetsLabel}</MonoLabel>
      <div
        role="radiogroup"
        aria-labelledby="sieve-presets-label"
        class="flex flex-wrap gap-2"
        data-sieve-presets
      >
        {
          d.presets.map((phrase, i) => (
            <button
              type="button"
              role="radio"
              aria-checked={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-preset={i}
              data-active={i === 0 ? '' : undefined}
              class="border-border text-body-sm text-ink data-[active]:border-b-lime hover:border-border-strong min-h-11 rounded-md border px-3 font-medium transition-colors data-[active]:border-b-[3px]"
            >
              {phrase}
            </button>
          ))
        }
      </div>
    </div>
    <div class="flex gap-2">
      <button
        type="button"
        id="sieve-run"
        aria-label={d.btnRunAria}
        class="bg-lime text-ink-on-lime hover:bg-lime-hover min-h-11 rounded-md px-5 text-[0.95rem] font-medium transition-colors active:translate-y-px"
      >
        {d.btnRun}
      </button>
      <button
        type="button"
        id="sieve-reset"
        aria-label={d.btnResetAria}
        class="border-border text-ink hover:border-border-strong min-h-11 rounded-md border px-4 text-[0.95rem] font-medium transition-colors"
      >
        {d.btnReset}
      </button>
    </div>
  </div>

  {/* Query row */}
  <div class="mt-5 flex flex-wrap items-center gap-x-3 gap-y-2">
    <MonoLabel>{d.laneQuery}</MonoLabel>
    <span aria-hidden="true" class="text-border-strong">›</span>
    <ul class="flex flex-wrap gap-1.5" data-sieve-tokens>
      {
        tokens.map((tok) => (
          <li class="border-hairline bg-surface text-ink rounded-sm border px-2 py-1 font-mono text-[0.75rem]">
            {tok}
          </li>
        ))
      }
    </ul>
    <MonoLabel class="text-lime-text ml-auto">{d.laneEmbed}</MonoLabel>
  </div>

  {/* Semantic space */}
  <figure class="mt-4">
    <div class="border-hairline bg-surface relative overflow-hidden rounded-md border">
      <svg
        viewBox={`0 0 ${VBW} ${VBH}`}
        role="img"
        aria-labelledby="sieve-fig-title sieve-fig-desc"
        class="h-auto w-full"
        data-sieve-svg
      >
        <title id="sieve-fig-title">{d.figureTitle}</title>
        <desc id="sieve-fig-desc">{d.figureDesc}</desc>

        {/* faint frame */}
        <rect x="16" y="24" width={VBW - 32} height={VBH - 40} rx="4" fill="none" stroke="#ECEEE6"
        ></rect>
        <text x="20" y="18" fill="#5F6659" style="font-family:var(--font-mono);font-size:10px"
          >{d.laneSpace}</text
        >

        {/* leaders (query → nearest neighbours) */}
        <g
          stroke="#95D600"
          stroke-width="1.5"
          stroke-linecap="round"
          fill="none"
          data-sieve-leaders
        >
          {
            leaders.map((l) => (
              <line
                x1={q1[0]}
                y1={q1[1]}
                x2={l.x2}
                y2={l.y2}
                pathLength="1"
                style="stroke-dasharray:1;stroke-dashoffset:0"
              />
            ))
          }
        </g>

        {/* documents */}
        <g data-sieve-docs>
          {
            CORPUS.map((_c, i) => {
              const rank = nnRank.get(i);
              const isNn = rank !== undefined;
              return (
                <circle
                  data-doc={i}
                  cx={docPos[i][0]}
                  cy={docPos[i][1]}
                  r={isNn ? 4.5 : 3.5}
                  fill={isNn ? '#95D600' : '#C9CEC1'}
                />
              );
            })
          }
        </g>

        {/* neighbour halos + cosine chips */}
        <g data-sieve-halos>
          {
            P1.neighbours.map((n) => (
              <circle
                cx={docPos[n.doc][0]}
                cy={docPos[n.doc][1]}
                r="8.5"
                fill="none"
                stroke="#95D600"
                stroke-width="1.2"
              />
            ))
          }
        </g>
        <g data-sieve-chips fill="#0B0F0A" style="font-family:var(--font-mono);font-size:11px">
          {
            P1.neighbours.map((n) => (
              <text x={docPos[n.doc][0] + 11} y={docPos[n.doc][1] + 4}>
                {scoreDot(n.score)}
              </text>
            ))
          }
        </g>

        {/* query point */}
        <g data-sieve-query transform={`translate(${q1[0]} ${q1[1]})`}>
          <circle r="9" fill="none" stroke="#95D600" stroke-width="1.2"></circle>
          <circle r="5" fill="#95D600"></circle>
        </g>
      </svg>
    </div>
    <figcaption class="measure text-body-sm text-muted mt-3" data-sieve-figcaption>
      {fig}
    </figcaption>
  </figure>

  {/* Ranked results */}
  <div class="mt-5">
    <MonoLabel as="p" class="mb-2">{d.resultsTitle}</MonoLabel>
    <ol class="border-hairline overflow-hidden rounded-md border" data-sieve-results>
      {
        rows.map((r, i) => (
          <li
            class:list={[
              'border-hairline bg-surface grid grid-cols-[2rem_1fr_auto] items-center gap-3 border-t px-4 py-2.5 first:border-t-0',
              i === 0 && 'relative',
            ]}
          >
            {i === 0 && (
              <span class="bg-lime absolute top-0 left-0 h-full w-[3px]" aria-hidden="true" />
            )}
            <span class="mono-label">{String(r.rank).padStart(2, '0')}</span>
            <span class="text-body-sm text-ink flex items-center gap-2">
              <span data-cell="doc">{r.label}</span>
              <span
                class="mono-label text-lime-text"
                data-cell="nearest"
                style={i === 0 ? '' : 'display:none'}
              >
                {d.nearest}
              </span>
            </span>
            <span class="text-body-sm tnum text-ink font-mono" data-cell="score">
              {scoreDot(r.score)}
            </span>
          </li>
        ))
      }
    </ol>
  </div>

  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-sieve-live></p>

  <script
    type="application/json"
    data-sieve-copy
    is:inline
    set:html={JSON.stringify({
      locale,
      presets: d.presets,
      docs: d.docs,
      nearest: d.nearest,
      liveSet: d.liveSet,
      liveSearching: d.liveSearching,
      liveResult: d.liveResult,
      figcaptionTpl: d.figcaptionTpl,
    })}
  />
</div>
