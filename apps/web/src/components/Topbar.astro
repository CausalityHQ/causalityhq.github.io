---
import Logo from './Logo.astro';
import LanguageToggle from './LanguageToggle.astro';
import Button from './Button.astro';
import EuFlag from './EuFlag.astro';
import { getContent, localeHome, BRAND, type Locale } from '../i18n';

/**
 * Sticky header (design.md §00): 64px, sits flat on --bg, gains only a 1px
 * hairline bottom border after 80px of scroll (set via data-scrolled by JS —
 * no shadow, ever). Nav is anchor links with a 3px lime active underline +
 * aria-current. CTA hides below sm (the hero + final CTA carry it on mobile).
 */
interface Props {
  locale: Locale;
  activeNav?: string;
  path?: string;
}
const { locale, activeNav, path = '' } = Astro.props;
const t = getContent(locale);
// Anchors are home-prefixed so they also work from sub-pages (e.g. /eu-project/).
const home = localeHome(locale);

const navItems = [
  { key: 'services', href: `${home}#services`, label: t.nav.services },
  { key: 'products', href: `${home}#products`, label: t.nav.products },
  { key: 'approach', href: `${home}#approach`, label: t.nav.approach },
  { key: 'about', href: `${home}#about`, label: t.nav.about },
  { key: 'oss', href: `${home}open-source/`, label: t.nav.oss },
  { key: 'eu', href: `${home}eu-project/`, label: t.nav.euProjects },
  { key: 'contact', href: `${home}#contact`, label: t.nav.contact },
];
---

<header
  id="site-header"
  class="bg-bg data-[scrolled]:border-hairline sticky top-0 z-50 border-b border-transparent transition-colors duration-200"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <Logo locale={locale} />

    <nav aria-label={t.nav.primaryLabel} class="hidden lg:block">
      <ul class="flex items-center gap-0.5">
        {
          navItems.map((n) => {
            const active = activeNav === n.key;
            return (
              <li>
                <a
                  href={n.href}
                  aria-current={active ? 'true' : undefined}
                  class:list={[
                    'text-body-sm relative inline-flex min-h-11 items-center px-2.5 font-medium transition-colors',
                    active ? 'text-ink' : 'text-ink-700 hover:text-ink',
                  ]}
                >
                  {n.key === 'eu' && <EuFlag width={30} class="mr-2 shrink-0" />}
                  {n.label}
                  {active && (
                    <span
                      class="bg-lime absolute inset-x-2.5 bottom-2.5 h-[3px]"
                      aria-hidden="true"
                    />
                  )}
                </a>
              </li>
            );
          })
        }
      </ul>
    </nav>

    <div class="flex items-center gap-3">
      <LanguageToggle locale={locale} path={path} />
      <div class="hidden sm:block">
        <Button href={BRAND.emailHref} ariaLabel={t.nav.talkToUsAria}>{t.nav.talkToUs}</Button>
      </div>

      {/* Mobile menu — no-JS <details> disclosure (design.md idiom) */}
      <details class="mobile-menu relative lg:hidden">
        <summary
          class="border-border text-ink hover:border-border-strong flex min-h-11 w-11 cursor-pointer items-center justify-center rounded-md border transition-colors"
          aria-label={t.nav.primaryLabel}
        >
          <svg
            class="menu-open"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M4 7h16M4 12h16M4 17h16"></path>
          </svg>
          <svg
            class="menu-close"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </summary>
        <nav
          aria-label={t.nav.primaryLabel}
          class="border-hairline bg-surface absolute right-0 z-50 mt-2 w-64 overflow-hidden rounded-md border"
        >
          <ul class="flex flex-col py-1">
            {
              navItems.map((n) => (
                <li>
                  <a
                    href={n.href}
                    aria-current={activeNav === n.key ? 'true' : undefined}
                    class:list={[
                      'text-body-sm flex min-h-11 items-center gap-2 px-4 font-medium transition-colors',
                      activeNav === n.key
                        ? 'text-ink bg-surface-sunk'
                        : 'text-ink-700 hover:text-ink hover:bg-surface-sunk',
                    ]}
                  >
                    {n.key === 'eu' && <EuFlag width={22} class="shrink-0" />}
                    {n.label}
                  </a>
                </li>
              ))
            }
            <li class="border-hairline mt-1 border-t px-4 py-3">
              <Button href={BRAND.emailHref} ariaLabel={t.nav.talkToUsAria} class="w-full"
                >{t.nav.talkToUs}</Button
              >
            </li>
          </ul>
        </nav>
      </details>
    </div>
  </div>
</header>
