---
/**
 * The Causality mark: a brain fused with a gear, drawn in single-weight stroke
 * (design.md §2). One lime node is the "active" accent (the only lime per figure).
 * `currentColor` so it inherits ink on light and white/lime on the forest band.
 * Decorative here — the surrounding link carries the accessible name "Causality".
 */
interface Props {
  size?: number;
  class?: string;
  /** Render the central node in lime. Set false on tiny/monochrome contexts. */
  accent?: boolean;
}
const { size = 28, class: className, accent = true } = Astro.props;
---

<svg
  width={size}
  height={size}
  viewBox="0 0 48 48"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  class={className}
>
  {/* Gear teeth — schematic radial ticks */}
  <path
    d="M37 24 41 24 M33.19 33.19 36.02 36.02 M24 37 24 41 M14.81 33.19 11.98 36.02 M11 24 7 24 M14.81 14.81 11.98 11.98 M24 11 24 7 M33.19 14.81 36.02 11.98"
  ></path>
  {/* Gear body / brain boundary */}
  <circle cx="24" cy="24" r="13"></circle>
  {/* Brain sulci (folds) inside the body */}
  <path d="M24 12 C 21 16 27 20 24 24 C 21 28 27 32 24 35"></path>
  <path d="M19 16 C 15.5 19 16.5 24 20 26"></path>
  <path d="M29 16 C 32.5 19 31.5 24 28 26"></path>
  <path d="M17.5 29 C 19.5 31 21 31.4 23 30"></path>
  <path d="M30.5 29 C 28.5 31 27 31.4 25 30"></path>
  {/* The active node — one lime accent per figure */}
  <circle cx="24" cy="24" r="1.9" fill={accent ? '#95d600' : 'currentColor'} stroke="none"></circle>
</svg>
