---
import type { Locale } from '../i18n';
import Hero from './sections/Hero.astro';
import Positioning from './sections/Positioning.astro';
import Services from './sections/Services.astro';
import ProductsIntro from './sections/ProductsIntro.astro';
import ProductSieve from './sections/ProductSieve.astro';
import ProductStructura from './sections/ProductStructura.astro';
import About from './sections/About.astro';
import Approach from './sections/Approach.astro';
import FinalCta from './sections/FinalCta.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
---

<Hero locale={locale} />
<Positioning locale={locale} />
<Services locale={locale} />
<ProductsIntro locale={locale} />
<ProductSieve locale={locale} />
<ProductStructura locale={locale} />
<About locale={locale} />
<Approach locale={locale} />
<FinalCta locale={locale} />
