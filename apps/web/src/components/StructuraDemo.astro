---
import { getContent, type Locale } from '../i18n';
import MonoLabel from './MonoLabel.astro';
import CornerTicks from './CornerTicks.astro';

/**
 * STRUCTURA interactive walkthrough (INTERACTIVE.md §C). Three ruled lanes —
 * INPUTS → KNOWLEDGE GRAPH → AGENT ACTION — and a 5-step choreography driven by
 * structuraDemo.ts (Prev/Play/Next/Replay). Server-renders the RESOLVED end
 * state (no-JS / reduced-motion fallback); JS gates each step via `.is-on`.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const s = t.structura;
const d = s.demo;
const short = (label: string) => label.split(' · ')[0];

// graph node positions in a contained 300×240 space
const N = {
  supplier: [55, 52],
  product: [55, 188],
  order: [150, 120],
  invoice: [245, 58],
  shipment: [245, 182],
  status: [245, 120],
  agent: [150, 222],
} as const;
const mid = (a: readonly number[], b: readonly number[]) => [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
// base edges (from=3): from, to, relIndex
const baseEdges = [
  { a: N.supplier, b: N.order, rel: 0 },
  { a: N.order, b: N.product, rel: 1 },
  { a: N.order, b: N.invoice, rel: 2 },
  { a: N.order, b: N.shipment, rel: 3 },
];
---

<div
  data-demo="structura"
  class="border-hairline bg-surface-sunk relative rounded-md border p-5 md:p-7"
>
  <CornerTicks />

  {/* Header */}
  <div class="flex flex-col gap-2">
    <MonoLabel>{d.label}</MonoLabel>
    <p class="measure text-ink-700 text-body-sm">{d.intro}</p>
  </div>

  {/* Stage: three lanes */}
  <div class="mt-6 grid gap-4 md:grid-cols-[minmax(0,0.85fr)_minmax(0,1.5fr)_minmax(0,1fr)]">
    {/* Lane 1 — inputs */}
    <div class="border-hairline bg-surface rounded-md border p-4">
      <MonoLabel>INPUT</MonoLabel>
      <ul class="mt-3 flex flex-col gap-2">
        {
          ['PO.pdf', 'pallet.jpg', 'vm.m4a'].map((f, i) => (
            <li
              class="st-reveal border-hairline flex items-center gap-2 rounded-sm border px-2.5 py-2"
              data-from="1"
              style={`--st-delay:${i * 80}ms`}
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#4A5247"
                stroke-width="1.6"
                aria-hidden="true"
              >
                {i === 0 && <path d="M7 3h7l4 4v14H7zM14 3v4h4" />}
                {i === 1 && (
                  <g>
                    <rect x="4" y="6" width="16" height="12" rx="1" />
                    <circle cx="9" cy="11" r="1.4" />
                    <path d="M5 17l5-4 3 2 4-4 2 2" />
                  </g>
                )}
                {i === 2 && <path d="M6 9v6M10 5v14M14 8v8M18 10v4" stroke-linecap="round" />}
              </svg>
              <span class="text-body-sm text-ink font-mono">{f}</span>
            </li>
          ))
        }
      </ul>
      {/* extracted fields (step 2 only) */}
      <ul class="mt-3 flex flex-wrap gap-1.5" data-structura-extract>
        {
          ['Supplier', 'PO', 'Qty', 'Amount', 'Invoice'].map((f) => (
            <li
              class="st-reveal mono-label border-hairline bg-surface-sunk rounded-sm border px-2 py-1"
              data-only="2"
            >
              {f}
            </li>
          ))
        }
      </ul>
    </div>

    {/* Lane 2 — knowledge graph */}
    <div class="border-hairline bg-surface rounded-md border p-4">
      <MonoLabel>KNOWLEDGE GRAPH</MonoLabel>
      <svg
        viewBox="0 0 300 250"
        role="img"
        aria-labelledby="structura-fig-title structura-fig-desc"
        class="mt-2 h-auto w-full"
      >
        <title id="structura-fig-title">{s.diagramTitle}</title>
        <desc id="structura-fig-desc">{s.diagramDesc}</desc>

        {/* base edges */}
        <g class="st-reveal" data-from="3" stroke="#D6DACF" stroke-width="1.4">
          {baseEdges.map((e) => <line x1={e.a[0]} y1={e.a[1]} x2={e.b[0]} y2={e.b[1]} />)}
        </g>
        {/* base relation labels */}
        <g
          class="st-reveal"
          data-from="3"
          fill="#5F6659"
          style="font-family:var(--font-mono);font-size:8px"
        >
          {
            baseEdges.map((e) => {
              const m = mid(e.a, e.b);
              return (
                <text x={m[0]} y={m[1] - 2} text-anchor="middle">
                  {d.rels[e.rel]}
                </text>
              );
            })
          }
        </g>

        {/* agent read pulse + status edge (step 4) */}
        <g class="st-reveal" data-from="4">
          <line
            x1={N.agent[0]}
            y1={N.agent[1]}
            x2={N.order[0]}
            y2={N.order[1]}
            stroke="#95D600"
            stroke-width="1.4"
            stroke-dasharray="3 3"></line>
          <line
            x1={N.invoice[0]}
            y1={N.invoice[1]}
            x2={N.status[0]}
            y2={N.status[1]}
            stroke="#95D600"
            stroke-width="1.6"></line>
          <text
            x={mid(N.invoice, N.status)[0] + 6}
            y={mid(N.invoice, N.status)[1]}
            fill="#4C6E00"
            style="font-family:var(--font-mono);font-size:8px">{d.rels[4]}</text
          >
        </g>

        {/* base nodes (step 3) */}
        <g class="st-reveal" data-from="3">
          {
            (['supplier', 'order', 'product', 'invoice', 'shipment'] as const).map((k, i) => (
              <g>
                <circle
                  cx={N[k][0]}
                  cy={N[k][1]}
                  r={k === 'order' ? 6 : 5}
                  fill={k === 'order' ? '#95D600' : '#C9CEC1'}
                />
                <text
                  x={N[k][0]}
                  y={N[k][1] + (i % 2 === 0 ? -9 : 15)}
                  text-anchor="middle"
                  fill="#0B0F0A"
                  style="font-family:var(--font-mono);font-size:8.5px"
                >
                  {short(
                    d.nodes[['supplier', 'order', 'product', 'invoice', 'shipment'].indexOf(k)],
                  )}
                </text>
              </g>
            ))
          }
          {/* anchor ring on order */}
          <circle
            cx={N.order[0]}
            cy={N.order[1]}
            r="10"
            fill="none"
            stroke="#95D600"
            stroke-width="1.4"></circle>
        </g>

        {/* agent node (step 4) */}
        <g class="st-reveal" data-from="4">
          <rect
            x={N.agent[0] - 24}
            y={N.agent[1] - 9}
            width="48"
            height="18"
            rx="3"
            fill="#FFFFFF"
            stroke="#2A3326"
            stroke-width="1.2"></rect>
          <text
            x={N.agent[0]}
            y={N.agent[1] + 3}
            text-anchor="middle"
            fill="#0B0F0A"
            style="font-family:var(--font-mono);font-size:8.5px">AGENT</text
          >
        </g>

        {/* written status node (step 4) */}
        <g class="st-reveal" data-from="4">
          <circle cx={N.status[0]} cy={N.status[1]} r="6" fill="#95D600"></circle>
          <text
            x={N.status[0]}
            y={N.status[1] + 16}
            text-anchor="middle"
            fill="#4C6E00"
            style="font-family:var(--font-mono);font-size:8.5px">{short(d.nodes[5])}</text
          >
        </g>
      </svg>
    </div>

    {/* Lane 3 — agent action (browser wireframe) */}
    <div class="border-hairline bg-surface rounded-md border p-4">
      <MonoLabel>AGENT ACTION</MonoLabel>
      <div class="border-border mt-3 rounded-md border" aria-hidden="true">
        <div class="border-hairline text-meta border-b px-3 py-1.5 font-mono text-[0.7rem]">
          {d.browserUrl}
        </div>
        <div class="p-3">
          <div class="flex items-center justify-between gap-2">
            <span class="text-meta font-mono text-[0.7rem]">{d.browserField}</span>
            <span
              class="st-reveal border-hairline text-ink rounded-sm border px-2 py-0.5 font-mono text-[0.7rem]"
              data-from="5"
              data-structura-value>INV-2231</span
            >
          </div>
          <div
            class="border-lime mt-3 rounded-md border-[3px] px-3 py-2 text-center text-[0.8rem] font-medium"
            data-structura-btn
          >
            {d.browserButtonDone}
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Caption + toolbar */}
  <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p class="mono-label text-lime-text" data-structura-caption>{d.captions[4]}</p>
    <div class="flex items-center gap-2" role="group" aria-label={d.label} data-structura-toolbar>
      <button
        type="button"
        data-ctrl="prev"
        aria-label={d.ctrlPrev}
        class="border-border text-ink hover:border-border-strong flex min-h-11 min-w-11 items-center justify-center rounded-md border font-mono disabled:opacity-40"
        >◀</button
      >
      <button
        type="button"
        data-ctrl="play"
        aria-label={d.ctrlPlay}
        aria-pressed="false"
        class="bg-lime text-ink-on-lime hover:bg-lime-hover min-h-11 rounded-md px-4 font-mono text-[0.9rem]"
        >▶</button
      >
      <button
        type="button"
        data-ctrl="next"
        aria-label={d.ctrlNext}
        class="border-border text-ink hover:border-border-strong flex min-h-11 min-w-11 items-center justify-center rounded-md border font-mono disabled:opacity-40"
        >▶</button
      >
      <button
        type="button"
        data-ctrl="replay"
        aria-label={d.ctrlReplay}
        class="border-border text-ink hover:border-border-strong flex min-h-11 min-w-11 items-center justify-center rounded-md border font-mono"
        >↻</button
      >
      <span class="mono-label ml-1" aria-hidden="true" data-structura-readout
        >{d.stepReadout.replace('{n}', '5')}</span
      >
    </div>
  </div>

  <p class="mono-label mt-2">{d.hintKeyboard}</p>

  {/* Ordered stages (the accessible description) */}
  <ol class="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-5" data-reveal>
    {
      s.stages.map((stage, i) => (
        <li class="border-hairline bg-surface flex items-start gap-2 rounded-md border px-3 py-2.5">
          <span class="mono-label text-lime-text">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-body-sm text-ink-700">{stage}</span>
        </li>
      ))
    }
  </ol>

  <p class="measure text-body-sm text-muted mt-4" data-structura-figcaption>{d.figcaption}</p>
  <p class="visually-hidden" aria-live="polite" aria-atomic="true" data-structura-live></p>

  <script
    type="application/json"
    data-structura-copy
    is:inline
    set:html={JSON.stringify({
      captions: d.captions,
      sr: d.sr,
      statusReady: d.statusReady,
      stepReadout: d.stepReadout,
      browserButton: d.browserButton,
      browserButtonDone: d.browserButtonDone,
      ctrlPlay: d.ctrlPlay,
      ctrlPause: d.ctrlPause,
    })}
  />
</div>
