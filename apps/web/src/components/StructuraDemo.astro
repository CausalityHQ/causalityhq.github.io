---
import { getContent, type Locale } from '../i18n';
import MonoLabel from './MonoLabel.astro';
import CornerTicks from './CornerTicks.astro';

/**
 * STRUCTURA interactive walkthrough (INTERACTIVE.md §C). Three ruled lanes —
 * INPUTS → KNOWLEDGE GRAPH → AGENT ACTION — and a 5-step choreography driven by
 * structuraDemo.ts (Prev/Play/Next/Replay). Server-renders the RESOLVED end
 * state (no-JS / reduced-motion fallback); JS gates each step via `.is-on`.
 * The graph uses readable 2-line node cards; the step sentence is shown visibly.
 */
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const s = t.structura;
const d = s.demo;

// node label → { type, value } (labels are "Type · Value" or "Type · V1 · V2")
const parts = (label: string) => {
  const p = label.split(' · ');
  return { type: p[0], value: p.slice(1).join(' · ') };
};
// index into d.nodes: 0 supplier, 1 order, 2 product, 3 invoice, 4 shipment, 5 status
const NODE = {
  supplier: { i: 0, cx: 100, cy: 58, from: 3 },
  product: { i: 2, cx: 100, cy: 236, from: 3 },
  order: { i: 1, cx: 285, cy: 147, from: 3, anchor: true },
  invoice: { i: 3, cx: 470, cy: 58, from: 3 },
  shipment: { i: 4, cx: 470, cy: 236, from: 3 },
  status: { i: 5, cx: 470, cy: 147, from: 4, written: true },
} as const;
type Key = keyof typeof NODE;
const CW = 150;
const CH = 42;
const ctr = (k: Key) => [NODE[k].cx, NODE[k].cy] as const;
const edges: { a: Key; b: Key; rel: number; from: number; lime?: boolean }[] = [
  { a: 'supplier', b: 'order', rel: 0, from: 3 },
  { a: 'order', b: 'product', rel: 1, from: 3 },
  { a: 'order', b: 'invoice', rel: 2, from: 3 },
  { a: 'order', b: 'shipment', rel: 3, from: 3 },
  { a: 'invoice', b: 'status', rel: 4, from: 4, lime: true },
];
const mid = (a: readonly number[], b: readonly number[]) => [(a[0] + b[0]) / 2, (a[1] + b[1]) / 2];
const agent = [285, 250] as const;
---

<div
  data-demo="structura"
  class="border-hairline bg-surface-sunk relative rounded-md border p-5 md:p-7"
>
  <CornerTicks />

  {/* Header + visible step narration (also the aria-live region) */}
  <div class="flex flex-col gap-2">
    <MonoLabel>{d.label}</MonoLabel>
    <p
      class="text-ink-700 text-body-sm min-h-[3.25rem] max-w-[70ch] sm:min-h-[2.5rem]"
      aria-live="polite"
      aria-atomic="true"
      data-structura-live
    >
      {d.sr[4]}
    </p>
  </div>

  {/* Stage: three lanes (stack on mobile) */}
  <div class="mt-5 grid gap-4 lg:grid-cols-[minmax(0,0.8fr)_minmax(0,1.7fr)_minmax(0,1fr)]">
    {/* Lane 1 — inputs */}
    <div class="border-hairline bg-surface rounded-md border p-4">
      <MonoLabel>{d.laneInput}</MonoLabel>
      <ul class="mt-3 flex flex-col gap-2">
        {
          ['PO.pdf', 'pallet.jpg', 'vm.m4a'].map((f, i) => (
            <li
              class="st-reveal border-hairline flex items-center gap-2 rounded-sm border px-2.5 py-2"
              data-from="1"
            >
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="#4A5247"
                stroke-width="1.6"
                aria-hidden="true"
              >
                {i === 0 && <path d="M7 3h7l4 4v14H7zM14 3v4h4" />}
                {i === 1 && (
                  <g>
                    <rect x="4" y="6" width="16" height="12" rx="1" />
                    <circle cx="9" cy="11" r="1.4" />
                    <path d="M5 17l5-4 3 2 4-4 2 2" />
                  </g>
                )}
                {i === 2 && <path d="M6 9v6M10 5v14M14 8v8M18 10v4" stroke-linecap="round" />}
              </svg>
              <span class="text-body-sm text-ink font-mono">{f}</span>
            </li>
          ))
        }
      </ul>
      <ul class="mt-3 flex flex-wrap gap-1.5">
        {
          d.extractChips.map((f) => (
            <li
              class="st-reveal mono-label border-hairline bg-surface-sunk rounded-sm border px-2 py-1"
              data-only="2"
            >
              {f}
            </li>
          ))
        }
      </ul>
    </div>

    {/* Lane 2 — knowledge graph (readable node cards) */}
    <div class="border-hairline bg-surface rounded-md border p-4">
      <MonoLabel>{d.laneGraph}</MonoLabel>
      <svg
        viewBox="0 0 560 300"
        role="img"
        aria-labelledby="structura-fig-title structura-fig-desc"
        class="mt-2 h-auto w-full"
      >
        <title id="structura-fig-title">{s.diagramTitle}</title>
        <desc id="structura-fig-desc">{s.diagramDesc}</desc>

        {/* edges (behind cards) */}
        {
          edges.map((e) => {
            const a = ctr(e.a);
            const b = ctr(e.b);
            const m = mid(a, b);
            return (
              <g class="st-reveal" data-from={String(e.from)}>
                <line
                  x1={a[0]}
                  y1={a[1]}
                  x2={b[0]}
                  y2={b[1]}
                  stroke={e.lime ? '#95D600' : '#D6DACF'}
                  stroke-width={e.lime ? '2' : '1.4'}
                />
                <text
                  x={m[0]}
                  y={m[1] - 3}
                  text-anchor="middle"
                  fill={e.lime ? '#4C6E00' : '#5F6659'}
                  style="font-family:var(--font-mono);font-size:10px"
                >
                  {d.rels[e.rel]}
                </text>
              </g>
            );
          })
        }

        {/* agent read line (step 4) */}
        <g class="st-reveal" data-from="4">
          <line
            x1={agent[0]}
            y1={agent[1]}
            x2={ctr('order')[0]}
            y2={ctr('order')[1] + CH / 2}
            stroke="#95D600"
            stroke-width="1.4"
            stroke-dasharray="4 3"></line>
        </g>

        {/* node cards */}
        {
          (Object.keys(NODE) as Key[]).map((k) => {
            const n = NODE[k];
            const lbl = parts(d.nodes[n.i]);
            const lime = 'anchor' in n || 'written' in n;
            return (
              <g class="st-reveal" data-from={String(n.from)}>
                <rect
                  x={n.cx - CW / 2}
                  y={n.cy - CH / 2}
                  width={CW}
                  height={CH}
                  rx="4"
                  fill="#FFFFFF"
                  stroke={lime ? '#95D600' : '#C9CEC1'}
                  stroke-width={lime ? '2' : '1.3'}
                />
                <text
                  x={n.cx - CW / 2 + 10}
                  y={n.cy - 3}
                  fill="#0B0F0A"
                  style="font-family:var(--font-mono);font-size:12px;font-weight:600"
                >
                  {lbl.type}
                </text>
                <text
                  x={n.cx - CW / 2 + 10}
                  y={n.cy + 13}
                  fill="#4A5247"
                  style="font-family:var(--font-mono);font-size:10px"
                >
                  {lbl.value}
                </text>
              </g>
            );
          })
        }

        {/* agent node (step 4) */}
        <g class="st-reveal" data-from="4">
          <rect x={agent[0] - 40} y={agent[1] - 14} width="80" height="28" rx="4" fill="#0B0F0A"
          ></rect>
          <text
            x={agent[0]}
            y={agent[1] + 4}
            text-anchor="middle"
            fill="#FAFAF7"
            style="font-family:var(--font-mono);font-size:11px;letter-spacing:0.06em"
            >{d.agentLabel}</text
          >
        </g>
      </svg>
    </div>

    {/* Lane 3 — agent action (browser wireframe) */}
    <div class="border-hairline bg-surface rounded-md border p-4">
      <MonoLabel>{d.laneAction}</MonoLabel>
      <div class="border-border mt-3 rounded-md border" aria-hidden="true">
        <div class="border-hairline text-meta border-b px-3 py-1.5 font-mono text-[0.7rem]">
          {d.browserUrl}
        </div>
        <div class="p-3">
          <div class="flex items-center justify-between gap-2">
            <span class="text-meta font-mono text-[0.7rem]">{d.browserField}</span>
            <span
              class="st-reveal border-hairline text-ink rounded-sm border px-2 py-0.5 font-mono text-[0.7rem]"
              data-from="5"
              data-structura-value>INV-2231</span
            >
          </div>
          <div
            class="border-lime mt-3 rounded-md border-[3px] px-3 py-2 text-center text-[0.8rem] font-medium"
            data-structura-btn
          >
            {d.browserButtonDone}
          </div>
        </div>
      </div>
    </div>
  </div>

  {/* Caption + toolbar */}
  <div class="mt-5 flex flex-col gap-4 md:flex-row md:items-center md:justify-between">
    <p class="mono-label text-lime-text" data-structura-caption>{d.captions[4]}</p>
    <div class="flex items-center gap-2" role="group" aria-label={d.label} data-structura-toolbar>
      <button
        type="button"
        data-ctrl="prev"
        aria-label={d.ctrlPrev}
        class="border-border text-ink hover:border-border-strong flex min-h-11 min-w-11 items-center justify-center rounded-md border font-mono disabled:opacity-40"
        >◀</button
      >
      <button
        type="button"
        data-ctrl="play"
        aria-label={d.ctrlPlay}
        aria-pressed="false"
        class="bg-lime text-ink-on-lime hover:bg-lime-hover min-h-11 rounded-md px-4 font-mono text-[0.9rem]"
        >▶</button
      >
      <button
        type="button"
        data-ctrl="next"
        aria-label={d.ctrlNext}
        class="border-border text-ink hover:border-border-strong flex min-h-11 min-w-11 items-center justify-center rounded-md border font-mono disabled:opacity-40"
        >▶</button
      >
      <button
        type="button"
        data-ctrl="replay"
        aria-label={d.ctrlReplay}
        class="border-border text-ink hover:border-border-strong flex min-h-11 min-w-11 items-center justify-center rounded-md border font-mono"
        >↻</button
      >
      <span class="mono-label ml-1" aria-hidden="true" data-structura-readout
        >{d.stepReadout.replace('{n}', '5')}</span
      >
    </div>
  </div>

  <p class="mono-label mt-2">{d.hintKeyboard}</p>

  {/* Ordered stages (the accessible description) */}
  <ol class="mt-5 grid gap-2 sm:grid-cols-2 lg:grid-cols-5" data-reveal>
    {
      s.stages.map((stage, i) => (
        <li class="border-hairline bg-surface flex items-start gap-2 rounded-md border px-3 py-2.5">
          <span class="mono-label text-lime-text">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-body-sm text-ink-700">{stage}</span>
        </li>
      ))
    }
  </ol>

  <p class="measure text-body-sm text-muted mt-4">{d.figcaption}</p>

  <script
    type="application/json"
    data-structura-copy
    is:inline
    set:html={JSON.stringify({
      captions: d.captions,
      sr: d.sr,
      statusReady: d.statusReady,
      stepReadout: d.stepReadout,
      browserButton: d.browserButton,
      browserButtonDone: d.browserButtonDone,
      ctrlPlay: d.ctrlPlay,
      ctrlPause: d.ctrlPause,
    })}
  />
</div>
