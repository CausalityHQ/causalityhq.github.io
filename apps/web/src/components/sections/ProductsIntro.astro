---
import { getContent, type Locale } from '../../i18n';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
---

<Section id="products" labelledby="products-h2" pad="tight">
  <SectionHeader
    tag={t.productsIntro.tag}
    title={t.productsIntro.h2}
    id="products-h2"
    frame={t.productsIntro.frame}
  />
</Section>
