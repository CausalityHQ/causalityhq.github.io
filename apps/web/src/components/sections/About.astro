---
import { getContent, type Locale } from '../../i18n';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
---

<Section id="about" labelledby="about-h2">
  <SectionHeader tag={t.about.tag} title={t.about.h2} id="about-h2" />
  <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_auto] lg:items-start lg:gap-16">
    <p class="measure text-lead text-ink-700" data-reveal>{t.about.body}</p>
    <ul
      class="flex flex-wrap gap-2 self-start lg:flex-col"
      data-reveal
      style="--reveal-delay:100ms"
    >
      {
        t.about.roster.map((r) => (
          <li class="border-hairline bg-surface text-ink inline-flex items-center gap-2 rounded-sm border px-3 py-2 text-[0.9rem] font-medium">
            <span class="bg-lime h-1.5 w-1.5 shrink-0 rounded-full" aria-hidden="true" />
            {r}
          </li>
        ))
      }
    </ul>
  </div>
</Section>
