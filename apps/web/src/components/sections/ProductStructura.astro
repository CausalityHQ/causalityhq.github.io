---
import { getContent, BRAND, type Locale } from '../../i18n';
import Section from '../Section.astro';
import MonoLabel from '../MonoLabel.astro';
import Button from '../Button.astro';
import SpecTable from '../SpecTable.astro';
import StructuraDemo from '../StructuraDemo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
---

<Section id="structura" labelledby="structura-h3">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
    {/* Documentation */}
    <div data-reveal>
      <MonoLabel>{t.structura.ref}</MonoLabel>
      <p class="font-display text-ink mt-3 text-[1.25rem] font-bold tracking-[0.06em] uppercase">
        {t.structura.name}
      </p>
      <h3 id="structura-h3" class="text-h3 text-ink mt-2 font-semibold">{t.structura.h3}</h3>
      <p class="measure text-ink-700 mt-4">{t.structura.body}</p>
      <div class="mt-7">
        <Button href={BRAND.emailHrefStructura} ariaLabel={t.structura.ctaAria}>
          {t.structura.cta}
        </Button>
      </div>
    </div>

    {/* Specifications */}
    <div class="lg:pt-2" data-reveal style="--reveal-delay:120ms">
      <SpecTable
        caption={t.structura.specCaption}
        headCapability={t.structura.specHeadCapability}
        headDetail={t.structura.specHeadDetail}
        rows={t.structura.specs}
      />
    </div>
  </div>

  {/* Full-width pipeline */}
  <div class="mt-12 md:mt-16" data-reveal>
    <StructuraDemo locale={locale} />
  </div>
</Section>
