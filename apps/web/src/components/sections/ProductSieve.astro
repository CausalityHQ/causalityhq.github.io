---
import { getContent, BRAND, type Locale } from '../../i18n';
import Section from '../Section.astro';
import MonoLabel from '../MonoLabel.astro';
import Button from '../Button.astro';
import SpecTable from '../SpecTable.astro';
import PerimeterDiagram from '../PerimeterDiagram.astro';
import SieveDemo from '../SieveDemo.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
---

<Section id="sieve" labelledby="sieve-h2">
  <div class="grid gap-10 lg:grid-cols-2 lg:items-start lg:gap-14">
    {/* Documentation */}
    <div data-reveal>
      <MonoLabel>{t.sieve.ref}</MonoLabel>
      <p class="text-ink mt-3 font-mono text-[1.05rem] font-bold tracking-[0.16em] uppercase">
        {t.sieve.name}
      </p>
      <h2 id="sieve-h2" class="text-h3 text-ink mt-2 font-semibold">{t.sieve.h3}</h2>
      <p class="measure text-ink-700 mt-4">{t.sieve.body}</p>

      <div class="mt-7">
        <SpecTable
          caption={t.sieve.specCaption}
          headCapability={t.sieve.specHeadCapability}
          headDetail={t.sieve.specHeadDetail}
          rows={t.sieve.specs}
        />
      </div>

      <div class="mt-7">
        <Button href={BRAND.emailHrefSieve} ariaLabel={t.sieve.ctaAria}>{t.sieve.cta}</Button>
      </div>
    </div>

    {/* On-prem architecture diagram */}
    <div class="lg:pt-2" data-reveal style="--reveal-delay:120ms">
      <PerimeterDiagram
        title={t.sieve.diagramTitle}
        desc={t.sieve.diagramDesc}
        summary={t.sieve.diagramSummary}
        perimeterLabel={t.sieve.perimeterLabel}
        egressLabel={t.sieve.egressLabel}
        dataStore={t.sieve.perimeterDataStore}
        query={t.sieve.perimeterQuery}
        blocked={t.sieve.perimeterBlocked}
      />
    </div>
  </div>

  {/* Interactive bench test — proof of function (below the two-column block) */}
  <div class="border-hairline mt-12 border-t pt-10 md:mt-16" data-reveal>
    <SieveDemo locale={locale} />
  </div>
</Section>
