---
import { getContent, type Locale } from '../../i18n';
import Section from '../Section.astro';
import MonoLabel from '../MonoLabel.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
---

<Section labelledby="trust-h2" pad="tight">
  <div
    class="flex flex-col gap-6 md:flex-row md:items-center md:justify-between md:gap-10"
    data-reveal
  >
    <div class="flex flex-col gap-3 sm:flex-row sm:items-baseline sm:gap-5">
      <MonoLabel class="shrink-0">{t.trust.label}</MonoLabel>
      <h2 id="trust-h2" class="text-h3 text-ink max-w-[40ch] font-semibold">{t.trust.line}</h2>
    </div>
    <ul class="flex flex-wrap gap-2">
      {
        t.trust.chips.map((c) => (
          <li class="border-hairline bg-surface text-ink-700 inline-flex items-center gap-2 rounded-sm border px-3 py-1.5 text-[0.8rem] font-medium">
            <span class="bg-lime h-1.5 w-1.5 shrink-0 rounded-full" aria-hidden="true" />
            {c}
          </li>
        ))
      }
    </ul>
  </div>
</Section>
