---
import { getContent, type Locale } from '../../i18n';
import Section from '../Section.astro';
import SectionHeader from '../SectionHeader.astro';
import CapabilityRow from '../CapabilityRow.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getContent(locale);
const icons = ['chip', 'research', 'braces', 'box'] as const;
---

<Section id="services" labelledby="services-h2">
  <SectionHeader tag={t.services.tag} title={t.services.h2} id="services-h2" />
  <div class="mt-10 md:mt-12">
    {t.services.items.map((item, i) => <CapabilityRow item={item} icon={icons[i]} />)}
  </div>
</Section>
