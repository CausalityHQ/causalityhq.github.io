---
/**
 * STRUCTURA pipeline (design.md §06): scattered multimodal glyphs (grey) resolve
 * into an ordered lime knowledge graph, then flow to an agent acting on the web.
 * The value literally turns from grey (chaos) to lime (structure/action) left→
 * right. The visible ordered stage list below is the accessible pipeline
 * description; the SVG carries <title>/<desc> and the <figcaption> the summary.
 */
interface Props {
  title: string;
  desc: string;
  summary: string;
  stages: string[];
  class?: string;
}
const { title, desc, summary, stages, class: className } = Astro.props;
---

<figure class:list={['flex flex-col gap-5', className]}>
  <div class="border-hairline bg-surface-sunk relative w-full rounded-md border p-3" data-draw>
    <svg
      viewBox="0 0 640 200"
      role="img"
      aria-labelledby="structura-diagram-title structura-diagram-desc"
      class="h-auto w-full"
    >
      <title id="structura-diagram-title">{title}</title>
      <desc id="structura-diagram-desc">{desc}</desc>

      {/* S1 — scattered multimodal glyphs (grey / unstructured) */}
      <g
        fill="none"
        stroke="#4A5247"
        stroke-width="1.4"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <rect x="38" y="40" width="30" height="40" rx="2"></rect>
        <path d="M44 52h18M44 60h18M44 68h11" stroke="#8A9182"></path>
        <rect x="80" y="96" width="34" height="28" rx="2"></rect>
        <circle cx="90" cy="106" r="3"></circle>
        <path d="M82 122l10-11 7 7 9-9 6 6"></path>
        <path d="M44 150v-16M52 150v-24M60 150v-12M68 150v-20M76 150v-8" stroke="#8A9182"></path>
      </g>

      {/* arrow 1 */}
      <line
        class="draw-path"
        pathLength="1"
        x1="126"
        y1="104"
        x2="192"
        y2="104"
        stroke="#C9CEC1"
        stroke-width="1.6"
        style="--draw-delay:200ms"></line>
      <path
        class="draw-fade"
        d="M186 99l7 5-7 5"
        fill="none"
        stroke="#C9CEC1"
        stroke-width="1.6"
        style="--fade-delay:520ms"></path>

      {/* S2 — extraction into structured rows */}
      <g fill="#FFFFFF" stroke="#4A5247" stroke-width="1.4">
        <rect x="206" y="80" width="52" height="48" rx="3"></rect>
      </g>
      <g stroke="#8A9182" stroke-width="1.2">
        <line x1="214" y1="94" x2="250" y2="94"></line>
        <line x1="214" y1="104" x2="250" y2="104"></line>
        <line x1="214" y1="114" x2="250" y2="114"></line>
      </g>

      {/* arrow 2 */}
      <line
        class="draw-path"
        pathLength="1"
        x1="266"
        y1="104"
        x2="336"
        y2="104"
        stroke="#C9CEC1"
        stroke-width="1.6"
        style="--draw-delay:520ms"></line>
      <path
        class="draw-fade"
        d="M330 99l7 5-7 5"
        fill="none"
        stroke="#C9CEC1"
        stroke-width="1.6"
        style="--fade-delay:840ms"></path>

      {/* S3 — lime knowledge graph (structured / valuable) */}
      <g
        class="draw-path"
        stroke="#95D600"
        stroke-width="1.8"
        fill="none"
        style="--draw-delay:820ms"
      >
        <line pathLength="1" x1="360" y1="104" x2="398" y2="74"></line>
        <line pathLength="1" x1="360" y1="104" x2="404" y2="136"></line>
        <line pathLength="1" x1="398" y1="74" x2="446" y2="104"></line>
        <line pathLength="1" x1="404" y1="136" x2="446" y2="104"></line>
      </g>
      <g class="draw-fade" fill="#95D600" style="--fade-delay:1180ms">
        <circle cx="360" cy="104" r="4"></circle>
        <circle cx="398" cy="74" r="4"></circle>
        <circle cx="404" cy="136" r="4"></circle>
        <circle cx="446" cy="104" r="4"></circle>
      </g>

      {/* arrow 3 */}
      <line
        class="draw-path"
        pathLength="1"
        x1="462"
        y1="104"
        x2="520"
        y2="104"
        stroke="#C9CEC1"
        stroke-width="1.6"
        style="--draw-delay:1180ms"></line>
      <path
        class="draw-fade"
        d="M514 99l7 5-7 5"
        fill="none"
        stroke="#C9CEC1"
        stroke-width="1.6"
        style="--fade-delay:1480ms"></path>

      {/* S4 — agent acts on the web (lime focal beat, arrives last) */}
      <g class="draw-fade" style="--fade-delay:1480ms">
        <circle cx="546" cy="104" r="6" fill="#95D600"></circle>
        <circle cx="546" cy="104" r="10" fill="none" stroke="#95D600" stroke-width="1.2"></circle>
        <line x1="556" y1="102" x2="580" y2="98" stroke="#95D600" stroke-width="1.8"></line>
        <g fill="none" stroke="#2A3326" stroke-width="1.4">
          <circle cx="600" cy="96" r="13"></circle>
          <ellipse cx="600" cy="96" rx="5.5" ry="13"></ellipse>
          <line x1="587" y1="96" x2="613" y2="96"></line>
        </g>
      </g>
    </svg>
  </div>

  {/* Ordered pipeline stages — the accessible description of the flow */}
  <ol class="grid gap-2 sm:grid-cols-2 lg:grid-cols-4" data-reveal>
    {
      stages.map((s, i) => (
        <li class="border-hairline bg-surface flex items-start gap-2 rounded-md border px-3 py-2.5">
          <span class="mono-label text-lime-text">{String(i + 1).padStart(2, '0')}</span>
          <span class="text-body-sm text-ink-700">{s}</span>
        </li>
      ))
    }
  </ol>

  <figcaption class="measure text-body-sm text-muted">{summary}</figcaption>
</figure>
