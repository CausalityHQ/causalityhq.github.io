---
/**
 * Hero motif (design.md §01 / §08): the real Causality brain-and-gear mark
 * (cropped from the official lockup, recoloured ink). It floats gently, lime
 * nodes orbit it (the "reasoning" accent), and the whole group parallaxes toward
 * the pointer (heroField.ts). Decorative — the header logo + H1 carry the brand,
 * so the figure is aria-hidden. Reduced-motion / no-JS → a still, framed mark.
 */
import { Image } from 'astro:assets';
import markInk from '../assets/brand/causality-mark-ink.png';

interface Props {
  title?: string;
  desc?: string;
  class?: string;
}
const { class: className } = Astro.props;
---

<figure
  class:list={['relative flex aspect-[420/380] items-center justify-center', className]}
  data-demo="hero"
  aria-hidden="true"
>
  {/* interactive semantic constellation (lazy Canvas 2D, behind the mark) */}
  <canvas class="hero-canvas" aria-hidden="true"></canvas>

  <div
    class="hero-parallax relative flex aspect-square w-full max-w-[22rem] items-center justify-center"
  >
    <span class="hero-ring" aria-hidden="true"></span>
    <span class="hero-orbit" aria-hidden="true"><i class="hero-orbit-dot"></i></span>
    <span class="hero-orbit hero-orbit--b" aria-hidden="true"
      ><i class="hero-orbit-dot hero-orbit-dot--sm"></i></span
    >
    <Image
      class="hero-mark relative"
      src={markInk}
      alt=""
      width={158}
      height={165}
      densities={[1, 2]}
      loading="eager"
    />
  </div>
</figure>
