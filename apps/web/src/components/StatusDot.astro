---
/**
 * Lime status marker. The dot is decorative; the text label carries the meaning
 * (colour is never the sole signal — WCAG 1.4.1). Pulse is reduced-motion aware.
 */
interface Props {
  label: string;
  pulse?: boolean;
  class?: string;
  labelClass?: string;
}
const { label, pulse = true, class: className, labelClass } = Astro.props;
---

<span class:list={['inline-flex items-center gap-2', className]}>
  <span class:list={['status-dot', pulse && 'status-dot--pulse']} aria-hidden="true"></span>
  <span class:list={labelClass}>{label}</span>
</span>
